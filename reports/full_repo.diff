+# R1: Deterministic "random" affine-linear alphabet (seed=20260107) + sparse allow adjacency
+# Vars: x,y. Letters are affine-linear forms (no division), to keep sampling stable.
+
+[experiment]
+id = "R1_rand_affine_seed20260107"
+title = "Random affine-linear 6-letter alphabet (seed=20260107) with sparse allow-adjacency"
+out_dir = "reports/m1/R1_rand_affine_seed20260107"
+w_min = 1
+w_max = 12
+
+[alphabet]
+vars = ["x", "y"]
+
+# r1 = 1 - 2x - y
+[[alphabet.letters]]
+name = "r1"
+expr = "(+ 1 (* -2 x) (- y))"
+
+# r2 = 3 + x - 2y
+[[alphabet.letters]]
+name = "r2"
+expr = "(+ 3 x (* -2 y))"
+
+# r3 = 1 - x - y
+[[alphabet.letters]]
+name = "r3"
+expr = "(+ 1 (- x) (- y))"
+
+# r4 = 2 + x - y
+[[alphabet.letters]]
+name = "r4"
+expr = "(+ 2 x (- y))"
+
+# r5 = 3 - 2x + 2y
+[[alphabet.letters]]
+name = "r5"
+expr = "(+ 3 (* -2 x) (* 2 y))"
+
+# r6 = 3 - x + y
+[[alphabet.letters]]
+name = "r6"
+expr = "(+ 3 (- x) y)"
+
+[constraints]
+first_entry = ["r1", "r2", "r6"]
+
+# Only allow the listed directed edges; all other adjacencies are forbidden.
+adjacency_mode = "allow"
+adjacency_pairs = [
+  ["r1","r2"],
+  ["r1","r3"],
+  ["r1","r4"],
+  ["r1","r5"],
+  ["r2","r3"],
+  ["r3","r1"],
+  ["r3","r4"],
+  ["r4","r6"],
+  ["r5","r3"],
+  ["r6","r4"],
+]
+
+[pairs]
+count_mode = "active_word_positions"
