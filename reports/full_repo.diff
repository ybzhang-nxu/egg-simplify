@@ -0,0 +1,60 @@
+# L2: Dixon lecture letter set S'={a,b,c,d,e,f} + Steinmann/ES forbidden adjacent pairs
+# Variables: u,v,w (cross ratios).
+# Letters:
+#   a=u/(vw), b=v/(wu), c=w/(uv), d=(1-u)/u, e=(1-v)/v, f=(1-w)/w
+
+[experiment]
+id = "L2_Dixon_Sprime_Steinmann"
+title = "Dixon S' 6-letter alphabet with first-entry {a,b,c} and forbidden adjacent pairs"
+out_dir = "reports/m1/L2_Dixon_Sprime_Steinmann"
+w_min = 1
+w_max = 8
+
+[alphabet]
+vars = ["u", "v", "w"]
+
+[[alphabet.letters]]
+name = "a"
+expr = "(/ u v w)"
+
+[[alphabet.letters]]
+name = "b"
+expr = "(/ v w u)"
+
+[[alphabet.letters]]
+name = "c"
+expr = "(/ w u v)"
+
+# d=(1-u)/u
+[[alphabet.letters]]
+name = "d"
+expr = "(/ (+ 1 (- u)) u)"
+
+# e=(1-v)/v
+[[alphabet.letters]]
+name = "e"
+expr = "(/ (+ 1 (- v)) v)"
+
+# f=(1-w)/w
+[[alphabet.letters]]
+name = "f"
+expr = "(/ (+ 1 (- w)) w)"
+
+[constraints]
+# First-entry: physical first-entry condition mapped to S' subset {a,b,c}.
+first_entry = ["a", "b", "c"]
+
+# Adjacency: forbid the listed directed pairs; allow all other pairs.
+adjacency_mode = "forbid"
+adjacency_pairs = [
+  ["d","e"], ["e","d"],
+  ["e","f"], ["f","e"],
+  ["f","d"], ["d","f"],
+
+  ["a","d"], ["d","a"],
+  ["b","e"], ["e","b"],
+  ["c","f"], ["f","c"],
+]
+
+[pairs]
+count_mode = "active_word_positions"
